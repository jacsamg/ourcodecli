{
  "name": "@ourcodecli/material-symbols",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Jacob Samuel G.",
  "homepage": "https://github.com/jacsamg/ourcodecli",
  "description": "A CLI tool to generate self-hosted Google Material Symbols subsets",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "our-material-symbols": "./dist/index.js"
  },
  "files": [
    "./dist",
    "./config.schema.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jacsamg/ourcodecli.git"
  },
  "scripts": {
    "lint": "biome check",
    "clean": "our-delete dist .tsbuildinfo --force",
    "tsc": "tsc",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@ourcodecli/delete": "*",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^1.6.1"
  }
}
